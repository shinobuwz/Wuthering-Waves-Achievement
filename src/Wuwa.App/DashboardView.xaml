<UserControl x:Class="Wuwa.App.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="DashboardPageRoot">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="总览" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="成就进度、连招流程与常用游戏工具" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,20" />
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="成就总数" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="TotalText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="已完成" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CompletedText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="完成率" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="RateText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="正在追踪" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="TrackedText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="成就管理" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="搜索、筛选、追踪、OCR、Wiki 和数据交换。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,16"/><Button AutomationProperties.AutomationId="DashboardOpenAchievementsButton" Content="打开成就管理" Click="OpenAchievements_OnClick"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="连招助手" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RotationSummaryText" Text="尚未选择连招流程。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,16"/><Button AutomationProperties.AutomationId="DashboardOpenRotationButton" Content="打开连招助手" Click="OpenRotation_OnClick"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel><TextBlock Text="游戏工具" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="获取唤取链接或打开游戏覆盖地图。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,16"/><Button AutomationProperties.AutomationId="DashboardOpenGameToolsButton" Content="打开游戏工具" Click="OpenGameTools_OnClick"/></StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
