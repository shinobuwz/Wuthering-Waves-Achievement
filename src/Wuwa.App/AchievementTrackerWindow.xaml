<Window x:Class="Wuwa.App.AchievementTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="成就追踪"
        Width="420"
        Height="680"
        MinWidth="340"
        MinHeight="420"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="TrackerWindow">
    <Window.Resources>
        <DataTemplate x:Key="ExpandedTrackerTemplate">
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Context}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="42" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="已完成" Tag="{Binding Row.Id}" Click="Complete_OnClick" VerticalAlignment="Center" MinWidth="68" Margin="0" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactTrackerTemplate">
            <Border Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="▸" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="已完成" Tag="{Binding Row.Id}" Click="Complete_OnClick" MinWidth="68" MinHeight="28" Padding="8,4" Margin="0" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SearchResultTemplate">
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Context}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="已完成" Tag="{Binding Row.Id}" Click="Complete_OnClick" VerticalAlignment="Center" MinWidth="68" Margin="0" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="TitleBar"
                       Grid.Row="0"
                       Height="40"
                       Margin="0,0,0,10"
                       MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ClearTrackedButton"
                            AutomationProperties.AutomationId="TrackerClearButton"
                            Content="清空追踪列表"
                            Click="ClearTracked_OnClick"
                            Margin="0,0,6,0"
                            Padding="8,5" />
                    <Button x:Name="ExpandWorkspaceButton"
                            AutomationProperties.AutomationId="TrackerExpandWorkspaceButton"
                            Content="展开工作区"
                            Click="ExpandWorkspace_OnClick"
                            Margin="0,0,6,0"
                            Padding="10,5" />
                    <Button x:Name="CloseButton"
                            AutomationProperties.AutomationId="TrackerCloseButton"
                            Content="×"
                            Click="Close_OnClick"
                            Width="32"
                            MinWidth="32"
                            FontSize="18"
                            Padding="0"
                            Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="成就追踪" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TrackedCountText" Text="追踪 0 条" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         AutomationProperties.AutomationId="TrackerSearchBox"
                         TextChanged="SearchBox_OnTextChanged"
                         ToolTip="按成就名称搜索未完成成就"
                         Margin="0" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="搜索未完成成就名称"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="11,0,8,0"
                           IsHitTestVisible="False" />
            </Grid>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="TrackerScrollViewer">
                <StackPanel>
                    <TextBlock x:Name="TrackedHeaderText" Text="正在追踪" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="ExpandedTrackedItems" ItemTemplate="{StaticResource ExpandedTrackerTemplate}" />
                    <ItemsControl x:Name="CompactTrackedItems" ItemTemplate="{StaticResource CompactTrackerTemplate}" />
                    <TextBlock x:Name="SearchHeaderText" Text="搜索结果" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,6" Visibility="Collapsed" />
                    <ItemsControl x:Name="SearchResultItems" ItemTemplate="{StaticResource SearchResultTemplate}" />
                    <TextBlock x:Name="EmptyText"
                               Text="暂无追踪成就"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,24,0,24"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <Button x:Name="ReturnToGameButton"
                        AutomationProperties.AutomationId="TrackerReturnToGameButton"
                        Content="返回游戏"
                        Click="ReturnToGame_OnClick"
                        Margin="0"
                        Padding="10,5" />
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
