<Window x:Class="Wuwa.App.OcrStopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 控制"
        Width="286"
        Height="126"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        AutomationProperties.AutomationId="OcrStopOverlay">
    <Border Background="#F01A2428"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="OCR 自动运行中"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="●"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="8,0,0,0" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,8,0,9">
                <TextBlock Text="Ctrl+Shift+F12  停止并保留"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="11" />
                <TextBlock Text="Ctrl+Alt+F12  强制中止"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Row="2"
                    Content="停止并保留结果"
                    Click="Stop_OnClick"
                    HorizontalAlignment="Right"
                    MinWidth="118"
                    MinHeight="28"
                    Padding="10,4"
                    Margin="0" />
        </Grid>
    </Border>
</Window>
