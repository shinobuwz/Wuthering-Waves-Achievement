<Window x:Class="Wuwa.App.OcrWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 工具"
        Width="640"
        Height="620"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="翻页与校准设置" Click="PagingSettings_OnClick" MinWidth="128" Margin="12,0,0,0" />
            <StackPanel>
                <TextBlock Text="OCR 工具" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="集中管理扫描、分类遍历、翻页校准和扫描记录。"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="16"
                Margin="0,18,0,12">
            <StackPanel>
                <TextBlock Text="开始 OCR" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <WrapPanel>
                    <Button Content="扫描当前分类" Click="ScanCurrent_OnClick" MinWidth="125" />
                    <Button Content="全量扫描所有分类" Click="ScanFull_OnClick" MinWidth="145" />
                    <Button Content="校验未完成成就" Click="SearchSync_OnClick" MinWidth="145" Margin="0" />
                </WrapPanel>
                <TextBlock Text="扫描开始后本窗口会自动隐藏。Ctrl+Shift+F12 取消，Ctrl+Alt+F12 强制中止。"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="14"
                Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="清空扫描记录" Click="ClearHistory_OnClick" MinWidth="108" Margin="12,0,0,0" />
                <StackPanel>
                    <CheckBox x:Name="SkipScannedCheckBox"
                              Content="全量扫描时默认跳过已经扫描过的一级 / 二级分类组合"
                              Click="SkipScanned_OnClick" />
                    <TextBlock x:Name="HistorySummaryText"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="已扫描分类记录" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" x:Name="HistoryList" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CategoryText}" />
                                    <TextBlock Text="{Binding ScanText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PagesText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="关闭" Click="Close_OnClick" MinWidth="80" Margin="0" />
        </DockPanel>
    </Grid>
</Window>
