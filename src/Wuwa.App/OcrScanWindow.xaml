<Window x:Class="Wuwa.App.OcrScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 扫描"
        Width="560"
        Height="560"
        MinWidth="480"
        MinHeight="460"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="OCR 扫描工作台" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ModeText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="PhaseText" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="OcrPhaseText" />
                <TextBlock x:Name="LocationText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="OcrLocationText" />
                <ProgressBar x:Name="ScanProgressBar" Height="6" IsIndeterminate="True" Margin="0,12,0,0" AutomationProperties.AutomationId="OcrProgressBar" />
                <TextBlock x:Name="LatestMessageText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="OcrLatestMessageText" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="已匹配" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="MatchedText" Text="0" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="OcrMatchedText" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="未匹配" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="UnmatchedText" Text="0" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="OcrUnmatchedText" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="扫描页" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="PageText" Text="0" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="OcrPageText" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="警告" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="WarningText" Text="0" FontSize="20" FontWeight="SemiBold" AutomationProperties.AutomationId="OcrWarningText" /></StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="最近警告" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox Grid.Row="4" x:Name="WarningList" ItemsSource="{Binding Warnings}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" AutomationProperties.AutomationId="OcrWarningList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="•  {Binding}" TextWrapping="Wrap" Margin="6,4" Foreground="{DynamicResource MutedTextBrush}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="StateText" Text="准备中" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="OcrStateText" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消扫描" Click="Cancel_OnClick" AutomationProperties.AutomationId="OcrCancelButton" MinWidth="92" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="关闭" Click="Close_OnClick" AutomationProperties.AutomationId="OcrCloseButton" MinWidth="76" Margin="0" IsEnabled="False" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
