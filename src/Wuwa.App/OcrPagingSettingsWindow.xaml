<Window x:Class="Wuwa.App.OcrPagingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 翻页设置"
        Width="540"
        Height="620"
        MinWidth="520"
        MinHeight="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="OCR 翻页设置" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="可主动切换滚轮或拖动，并为当前机器调整翻页距离。扫描时会等待画面停稳后再识别。"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="16"
                Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="翻页方式" VerticalAlignment="Center" Margin="0,0,12,10" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MethodCombo" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Text="滚轮总距离" VerticalAlignment="Center" Margin="0,0,12,10" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBox x:Name="WheelDistanceBox" />
                    <TextBlock Text="正数，推荐 120–12000；默认 2400（等价于历史参数 160 × 15 次）。"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="拖动距离（像素）" VerticalAlignment="Center" Margin="0,0,12,10" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <TextBox x:Name="DragDistanceBox" />
                    <TextBlock Text="正数，推荐 80–800；默认 550。程序会按翻页方向自动取正负号。"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="滚轮事件间隔（ms）" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="WheelIntervalBox" Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Text="停稳检测起始等待（ms）" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SettleDelayBox" Margin="0,0,0,10" />

                <CheckBox Grid.Row="5" Grid.ColumnSpan="2"
                          x:Name="AutoCalibrateCheckBox"
                          Content="根据实际画面位移自动校准后续翻页距离和停稳等待"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="最近校准" FontWeight="SemiBold" />
                <TextBlock x:Name="CalibrationText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
                <TextBlock Text="“保存并校准”会在游戏成就页执行一次向下和向上翻页，测量实际位移并尽量回到原位置。请勿在校准期间操作游戏。"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" Click="Cancel_OnClick" MinWidth="76" />
                <Button Content="仅保存" Click="Save_OnClick" MinWidth="86" />
                <Button Content="保存并校准" Click="SaveAndCalibrate_OnClick" MinWidth="112" Margin="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
