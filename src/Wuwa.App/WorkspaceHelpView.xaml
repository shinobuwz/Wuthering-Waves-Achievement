<UserControl x:Class="Wuwa.App.WorkspaceHelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="WorkspaceHelpPage"
             Background="{DynamicResource WindowBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" />
        <Style x:Key="HelpSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="HelpTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HelpBodyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    AutomationProperties.AutomationId="WorkspaceHelpBackButton"
                    Content="返回主页面"
                    Click="Back_OnClick"
                    Width="104"
                    MinWidth="104"
                    Height="32"
                    MinHeight="32"
                    Margin="0"
                    VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="主页面使用帮助" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="筛选、状态维护、追踪、数据交换与辅助工具说明"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource SelectionBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,3">
                            <TextBlock Text="所有进度默认保存在本机"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="11" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="成就工作区快速指南" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="建议首次使用时先了解状态含义和数据备份方式"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource HelpSectionStyle}" BorderBrush="{DynamicResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="1. 推荐的首次使用流程" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="① 使用搜索框和版本、一级分类、二级分类、状态下拉框找到需要维护的成就。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="② 双击成就行可在“未完成”和“已完成”之间快速切换；需要设置“暂不可获取”或处理成就组时，请使用右键菜单。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="③ 使用 Ctrl 或 Shift 多选成就后加入追踪，再打开追踪浮窗，在游戏旁查看当前目标。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="④ 第一次完成进度整理后，建议使用“导出 JSON/Excel”立即创建一份外部备份。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="⑤ 如需自动识别游戏成就状态，进入 OCR 工作区，并先阅读 OCR 页面右上角的独立使用帮助。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="2. 搜索、筛选与列表操作" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 搜索框支持按成就名称或描述过滤；版本、一级分类、二级分类和状态筛选可以组合使用。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• “重置筛选”会清空搜索文字并恢复所有筛选项，不会修改任何成就状态。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 点击表头可按对应列排序。Ctrl 用于增减单个选择，Shift 用于连续多选。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 双击成就行可快速切换完成状态；右键菜单会对全部选中成就批量设置状态。仅选中一个成就时，右键菜单还会显示“复制成就名称”。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 底部状态栏会显示当前列表数量、操作提示或最近一次失败原因。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="3. 成就状态与成就组" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 未完成：尚未在游戏中完成，会计入当前待完成数量。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 已完成：已经确认完成，会计入完成率和已完成统计。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 暂不可获取：当前版本或当前条件下无法获取，不按普通未完成项目处理。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 已占用：同一互斥／多选一成就组中，其他成员完成后不可再选择的项目。该状态由工作区统一维护，不建议绕过右键菜单直接修改数据文件。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 隐藏成就和累计进度链可能属于同一成就组。修改其中一个成员时，请确认右键菜单中的组操作提示。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="4. 追踪功能" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 先在列表中使用 Ctrl／Shift 选择一个或多个成就，再点击“追踪选中成就”。通常只应追踪尚未完成的项目。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• “取消追踪选中”只移除追踪关系，不改变成就的完成状态。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• “打开追踪浮窗”会显示置顶小窗口，便于在窗口化游戏旁查看目标。关闭浮窗不会删除追踪列表。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 如果成就已经完成，可先更新状态，再根据需要取消追踪。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="5. OCR 扫描" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• “打开 OCR 工具”会在当前主窗口内切换到 OCR 工作区，不会打开新的主窗口。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• OCR 支持当前分类扫描、全量扫描、未完成成就校验、结果筛选、Tag 跳过管理以及独立翻页校准。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• OCR 结果不会自动修改进度，必须在扫描结果页检查、勾选并明确应用。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• OCR 对游戏分辨率、窗口模式、管理员权限和停止方式有额外要求，请务必阅读 OCR 工作区右上角的“使用帮助”。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="6. 数据导入、导出与 Wiki 同步" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 导入旧版进度：从旧版本工具迁移已有状态。执行前建议先导出当前数据，避免误覆盖。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 导入 JSON/Excel：读取受支持的交换文件并合并进度。导入后请检查修订号、统计和若干代表性成就。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 导出 JSON/Excel：创建可备份、迁移或人工检查的外部文件。重要批量操作前后都建议导出一份。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 同步 Wiki：更新成就基础资料和远端变更，不等同于上传或覆盖本地完成进度。同步后应关注新增、隐藏或暂不可获取项目。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 不要在程序运行时手工编辑 Native 工作区文件。需要跨设备迁移时优先使用导出和导入。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="7. 唤取链接、地图与系统功能" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 获取唤取链接：先在游戏中打开唤取记录并至少翻页一次，等待加载完成后再点击。工具会从 Client.log 读取链接并复制到剪贴板。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 打开游戏地图：在鸣潮窗口化或无边框窗口上方显示 Kuro 地图；地图快捷键会显示在按钮旁。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 浅色／深色主题：只改变显示外观，不影响数据。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 检查更新：检查可用程序版本；更新或替换程序前仍建议先导出进度。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 各操作分区标题右侧的“?”按钮提供对应功能的简短说明。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="8. 安全操作与问题排查" Style="{StaticResource HelpTitleStyle}" />
                            <TextBlock Text="• 大批量修改、导入、同步或升级前先导出备份；完成后检查修订号和统计是否符合预期。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 如果按钮没有产生预期结果，先查看主窗口底部的错误文字，不要连续重复执行导入或同步。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• OCR、地图或唤取链接涉及游戏窗口和本地日志，出现问题时应同时检查游戏窗口状态、权限和程序日志。" Style="{StaticResource HelpBodyStyle}" />
                            <TextBlock Text="• 遇到无法恢复的问题时，请保留导出文件和 log 目录，再记录复现步骤。" Style="{StaticResource HelpBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="提示：主页面的修订号会在进度或设置成功保存后变化。完成批量操作后，可用修订号和顶部统计快速确认工作区已经刷新。"
                               Foreground="{DynamicResource IncompleteStatusBrush}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="2,2,2,8" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
