<UserControl x:Class="Wuwa.App.GameToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="GameToolsPageRoot">
    <StackPanel Margin="22">
        <TextBlock Text="游戏工具" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="与成就和连招状态独立的现有工具。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="唤取记录链接" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="读取游戏日志并复制当前唤取记录链接。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="ConveneLinkButton" Content="获取唤取链接" Click="ConveneLink_OnClick"/>
                    <Button AutomationProperties.AutomationId="ConveneHelpButton" Content="使用说明" Click="ConveneHelp_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock Text="覆盖地图" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="在可见的《鸣潮》客户区上打开 Kuro 地图。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MapOverlayButton" AutomationProperties.AutomationId="MapOverlayButton" Content="打开游戏地图" Click="MapOverlay_OnClick"/>
                    <TextBlock x:Name="MapShortcutText" Text="地图快捷键：注册中" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
