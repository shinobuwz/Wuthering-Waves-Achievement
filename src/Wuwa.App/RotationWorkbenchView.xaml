<UserControl x:Class="Wuwa.App.RotationWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="RotationPageRoot"
             Focusable="True"
             PreviewKeyDown="Workbench_OnPreviewKeyDown"
             PreviewMouseDown="Workbench_OnPreviewMouseDown">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RotationImportButton" AutomationProperties.AutomationId="RotationImportButton" Content="导入 Hekili JSON" Click="Import_OnClick"/>
                <Button x:Name="RotationDeleteButton" AutomationProperties.AutomationId="RotationDeleteButton" Content="删除选中流程" Click="Delete_OnClick"/>
            </StackPanel>
            <StackPanel><TextBlock Text="连招助手" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="只观察物理输入并显示提示，不发送游戏操作。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="已保存流程" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="RotationProfileList" AutomationProperties.AutomationId="RotationProfileList" DisplayMemberPath="Name" SelectionChanged="ProfileList_OnSelectionChanged"/></DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="流程摘要" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileNameText" Text="请选择流程" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,4"/>
                    <TextBlock x:Name="TeamText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="SequenceText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14"/>
                    <TextBlock Text="运行说明" FontWeight="SemiBold"/>
                    <TextBlock Text="运行仅在《鸣潮》窗口位于前台时推进。Alt-Tab 会暂停并隐藏浮窗；Ctrl+Shift+F11 随时安全停止。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"><TextBlock Text="键鼠绑定" FontWeight="SemiBold"/><TextBlock Text="点击字段后按键盘键或鼠标键。Heavy 与 Basic 共用绑定。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RotationBindingsList" AutomationProperties.AutomationId="RotationBindingsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><Button Grid.Column="1" AutomationProperties.AutomationId="{Binding AutomationId}" Content="{Binding InputText}" Tag="{Binding Action}" Click="BindingButton_OnClick"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" x:Name="RotationStartButton" AutomationProperties.AutomationId="RotationStartButton" Content="开始连招" Width="120" Click="Start_OnClick" IsEnabled="False"/>
            <TextBlock x:Name="RotationValidationText" AutomationProperties.AutomationId="RotationValidationText" Text="请选择流程。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
