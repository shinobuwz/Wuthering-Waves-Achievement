<Window x:Class="Wuwa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wuwa.App"
        Title="鸣潮成就工作区"
        Width="1280"
        Height="780"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16,10,12">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="SettingsNavigationButton" AutomationProperties.AutomationId="SettingsNavigationButton" Content="设置" Click="SettingsNavigation_OnClick" Margin="0,3"/>
                    <Button x:Name="WorkspaceHelpButton" AutomationProperties.AutomationId="WorkspaceHelpButton" Content="使用帮助" Click="WorkspaceHelp_OnClick" Margin="0,3"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WUWA" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="8,0,0,18"/>
                    <Button x:Name="DashboardNavigationButton" AutomationProperties.AutomationId="DashboardNavigationButton" Content="总览" Click="DashboardNavigation_OnClick" Margin="0,3"/>
                    <Button x:Name="AchievementsNavigationButton" AutomationProperties.AutomationId="AchievementsNavigationButton" Content="成就管理" Click="AchievementsNavigation_OnClick" Margin="0,3"/>
                    <Button x:Name="RotationNavigationButton" AutomationProperties.AutomationId="RotationNavigationButton" Content="连招助手" Click="RotationNavigation_OnClick" Margin="0,3"/>
                    <Button x:Name="GameToolsNavigationButton" AutomationProperties.AutomationId="GameToolsNavigationButton" Content="游戏工具" Click="GameToolsNavigation_OnClick" Margin="0,3"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="0" Grid.Column="1" x:Name="ShellContent">
        <local:DashboardView x:Name="DashboardPage" />
        <local:AchievementWorkspaceView x:Name="AchievementPage" Visibility="Collapsed" />

        <local:OcrWorkbenchView x:Name="OcrWorkbenchPage" Visibility="Collapsed" />
        <local:RotationWorkbenchView x:Name="RotationPage" Visibility="Collapsed" />
        <local:GameToolsView x:Name="GameToolsPage" Visibility="Collapsed" />
        <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        <local:WorkspaceHelpView x:Name="WorkspaceHelpPage" Visibility="Collapsed" />
        </Grid>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="14,8,14,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink Style="{StaticResource BilibiliLinkStyle}"
                               ToolTip="打开作者 B 站：蓝若惜miss"
                               Click="AuthorBilibili_OnClick">Bilibili@蓝若惜miss</Hyperlink>
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="HintText" AutomationProperties.AutomationId="ShellStatusText" Text="Ctrl/Shift 多选 · 双击切换完成状态 · 右键批量设置选中项状态" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
