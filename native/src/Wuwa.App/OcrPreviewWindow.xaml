<Window x:Class="Wuwa.App.OcrPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 扫描预览"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="审核 OCR 候选" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="CandidateGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="None"
                      SelectionMode="Extended"
                      Background="{StaticResource PanelBrush}"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="应用" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                    <DataGridTextColumn Header="编号" Binding="{Binding Candidate.LegacyCode}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="匹配成就" Binding="{Binding Candidate.MatchedName}" IsReadOnly="True" Width="190" />
                    <DataGridTextColumn Header="OCR 原文" Binding="{Binding Candidate.OcrText}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="识别状态" Binding="{Binding StatusText}" IsReadOnly="True" Width="105" />
                    <DataGridTextColumn Header="匹配置信度" Binding="{Binding ConfidenceText}" IsReadOnly="True" Width="105" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="UnmatchedText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="72" />

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="已完成状态不会被 OCR 降级。未知状态默认不勾选。" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" Width="90" Click="Cancel_OnClick" />
                <Button Content="应用选中" Width="110" Click="Apply_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
